# Local-only application. Start your existing Kokoro app separately.
DATA_DIR=./data
TTS_BASE_URL=http://127.0.0.1:8000
TTS_VOICE=af_heart
TTS_TIMEOUT_MS=600000
# auto: API when LLM_API_KEY exists, otherwise source excerpts.
# codex: use your local Codex CLI's ChatGPT login; no API key required.
# api: explicitly use the OpenAI-compatible endpoint. extractive: source excerpts.
LLM_PROVIDER=auto
CODEX_BIN=codex
# Empty selects Codex's default model; this is independent of LLM_MODEL below.
CODEX_MODEL=
CODEX_TIMEOUT_MS=180000
# Optional OpenAI-compatible endpoint for research, visual direction and semantic QA.
# For image-aware direction the API model must accept image_url inputs.
# Codex direction attaches public-source previews through the saved ChatGPT login.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# ffmpeg is the fast default; hyperframes invokes local HTML composition rendering.
VIDEO_RENDERER=ffmpeg
CHROMIUM_EXECUTABLE_PATH=
# Optional infrastructure. Leave empty for atomic local JSON persistence + polling.
DATABASE_URL=
REDIS_URL=
# Public URLs only by default. Enable solely for trusted local fixtures/intranet.
ALLOW_PRIVATE_URLS=false
MAX_EXPLORE_PAGES=4
# Studio model defaults; UI-saved defaults take precedence for new jobs.
# Job overrides take precedence over studio defaults and persist through retries.
# default leaves effort to the model; other levels depend on the Codex model catalog.
CODEX_REASONING_EFFORT=medium
# restrained, balanced, or bold. Guides story/framing, never relaxes factual QA.
LLM_CREATIVITY=balanced

# Uploaded narration: local Whisper ASR and real word alignment.
# Empty automatically uses ../kokoro-local-tts/.venv/bin/python when available, else python3.
NARRATION_PYTHON=
# faster-whisper model name or local model directory (first use can download model weights).
NARRATION_WHISPER_MODEL=small
